# ==============================================================================
# Environment Configuration Template for py-broker-service
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Service Port
BROKER_SERVICE_PORT=8082

# SmartAPI Key
SMARTAPI_KEY=your_angelone_smartapi_key

# Paper-Trading Safety Switch (default: true)
# When true, all broker API interactions are simulated safely.
PAPER_TRADING_ENABLED=true
